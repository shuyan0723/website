        }

        .history-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: #1f4662;
        }

        .history-grid {
            display: flex;
            flex-direction: column;
            gap: 1.3rem;
        }

        .history-card {
            background: #ffffff;
            border-radius: 0.9rem;
            border: 1px solid #eef2f8;
            padding: 1rem 1.3rem;
            transition: 0.1s;
        }
        .history-card .h-title {
            font-weight: 700;
            font-size: 1rem;
            color: #1a4766;
        }
        .history-card .h-meta {
            font-size: 0.75rem;
            color: #6f8fb0;
            margin-top: 0.3rem;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        footer {
            margin-top: 3rem;
            text-align: center;
            font-size: 0.7rem;
            color: #8aa0b5;
            border-top: 1px solid #e4edf5;
            padding-top: 2rem;
        }

