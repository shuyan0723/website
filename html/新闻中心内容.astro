            font-size: 0.95rem;
        }

        .news-list {
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
            margin-bottom: 2.5rem;
        }

        .news-card {
            background: #ffffff;
            border-radius: 1rem;
            border: 1px solid #eef2f6;
            transition: all 0.2s ease;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
        }
        .news-card:hover {
            border-color: #cddfed;
            box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.08);
        }

        .card-inner {
            padding: 1.5rem 1.8rem;
        }

        .news-date {
            font-size: 0.8rem;
            font-weight: 500;
            color: #5c7f9c;
            letter-spacing: 0.3px;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .news-badge {
            background: #ecf3fa;
            color: #1f6392;
            font-size: 0.7rem;
            padding: 0.2rem 0.7rem;
            border-radius: 20px;
            font-weight: 500;
        }

        .news-title {
            font-size: 1.35rem;
            font-weight: 650;
            color: #0f2f48;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .news-excerpt {
            color: #446d8c;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            border-left: 3px solid #dce5ef;
            padding-left: 0.9rem;
        }

        .news-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1.2rem;
        }
        .tag {
            background: #f1f5f9;
            padding: 0.2rem 0.8rem;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 500;
            color: #2c6288;
        }

        .detail-btn {
            background: transparent;
            border: 1px solid #cbdde9;
            padding: 0.4rem 1.2rem;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 500;
            color: #1f6392;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
        }
        .detail-btn:hover {
            background: #eef3fc;
            border-color: #8bb4d0;
        }

        .full-detail {
            display: none;
            margin-top: 1.5rem;
            padding-top: 1.2rem;
            border-top: 1px solid #e9edf2;
            font-size: 0.9rem;
            color: #2c4a6e;
            line-height: 1.6;
        }
        .full-detail.show {
            display: block;
        }

        .detail-content {
            background: #fafcff;
            padding: 1rem 1.2rem;
            border-radius: 0.8rem;
            max-height: 400px;
            overflow-y: auto;
        }
