        }

        .hero-header {
            margin-bottom: 2.5rem;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 1rem;
        }
        .hero-header h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #0a2b44;
