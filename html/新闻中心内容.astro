            .page-container {
                padding: 1.2rem;
            }
            .news-title {
                font-size: 1.1rem;
            }
            .card-inner {
                padding: 1.2rem;
            }
        }
    </style>
</head>
<body>
<div class="page-container">
    <div class="hero-header">
        <h1>新闻中心</h1>
        <p>洞察行业趋势，传递极致价值</p>
    </div>

    <div class="news-list">
        {latestNews.map(news => (
            <div class="news-card" key={news.id}>
                <div class="card-inner">
                    <div class="news-date">
                        <span>{news.date}</span>
                        <span class="news-badge">最新动态</span>
                    </div>
                    <div class="news-title">{news.title}</div>
                    <div class="news-excerpt">{news.excerpt}</div>
                    <div class="news-tags">
                        {news.tags.map((tag, idx) => (
                            <span class="tag" key={idx}>{tag}</span>
                        ))}
                    </div>
                    <button class="detail-btn" data-id={news.id}>查看详情</button>
                    <div class="full-detail" id={`detail-${news.id}`}></div>
                </div>
            </div>
        ))}
    </div>

    <div class="history-wrapper">
        <button id="historyToggleBtn" class="history-btn">📰 查看历史新闻报道</button>
    </div>

    <div id="historySection" class="history-news-section">
        <div class="history-title">📌 往年全部新闻 · 业绩与里程碑</div>
        <div class="history-grid">
            {historyNews.map(news => (
                <div class="history-card" key={news.id}>
                    <div class="h-title">📌 {news.title}</div>
                    <div class="h-meta">
                        <span>📅 {news.date}</span>
                        <span>🏷️ {news.tags.join(' · ')}</span>
                    </div>
                    <div class="news-excerpt" style="margin-top: 0.5rem; font-size:0.85rem;">{news.excerpt}</div>
                    <button class="detail-btn history-detail-btn" data-id={news.id} style="margin-top: 0.8rem; font-size:0.7rem;">查看详情</button>
                    <div class="full-detail" id={`history-detail-${news.id}`} style="margin-top:0.8rem;"></div>
                </div>
            ))}
        </div>
    </div>
    
    <footer>© 昆仑时代（上海）系统集成有限公司 版权所有 | 创新驱动 · 服务金融科技主战场</footer>
</div>

<script is:inline>
    const newsData = ${JSON.stringify(allNews)};

    document.querySelectorAll('.detail-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const id = parseInt(btn.getAttribute('data-id'));
            const newsItem = newsData.find(n => n.id === id);
            const isHistory = btn.classList.contains('history-detail-btn');
            const targetId = isHistory ? `history-detail-${id}` : `detail-${id}`;
            const detailDiv = document.getElementById(targetId);
            
            if (detailDiv) {
                if (detailDiv.classList.contains('show')) {
                    detailDiv.classList.remove('show');
                    detailDiv.innerHTML = '';
                } else {
                    detailDiv.innerHTML = newsItem.fullDetail;
                    detailDiv.classList.add('show');
                }
            }
        });
    });

    const toggleBtn = document.getElementById('historyToggleBtn');
    const historySection = document.getElementById('historySection');
    
    if (toggleBtn && historySection) {
        toggleBtn.addEventListener('click', () => {
            if (historySection.classList.contains('show')) {
                historySection.classList.remove('show');
                toggleBtn.textContent = '📰 查看历史新闻报道';
            } else {
                historySection.classList.add('show');
                toggleBtn.textContent = '✖️ 收起历史新闻';
            }
        });
    }
</script>
</body>
</html>