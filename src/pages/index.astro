---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="企业官网">
  <div class="page-container">
    <Navbar />

    <section class="banner">
      <div class="decor-top-left"></div>
      <div class="decor-bottom-right"></div>

      <div class="banner-content">
        <div class="tag">2026 数字化领航者</div>
        <h1 class="banner-title">
          为未来企业构建<br />全栈数字引擎
        </h1>
        <p class="banner-desc">
          我们结合前沿技术研发能力与全球交付网络，为全球客户提供从战略咨询到交付落地的一站式数字化解决方案，驱动业务跨越式增长。
        </p>
        <div class="banner-buttons">
          <a href="/about" class="btn-primary">了解我们的实力</a>
        </div>
      </div>

     
    </section>

    <!-- 能力展示模块 -->
    <section class="capability-section">
      <!-- 三个椭圆背景（我帮你加在这里，不影响你的原有结构） -->
      <div class="ellipse-1"></div>
      <div class="ellipse-2"></div>
      <div class="ellipse-3"></div>

      <div class="capability-container">
        <div class="capability-left">
          <h2 class="capability-title">全域覆盖的能力保障，<br>赋能业务核心价值。</h2>
          <p class="capability-desc">
            极智数科（UltraDigit）在数字化转型领域建立了全球化的交付体系。我们通过分布在全国及海外的数十个分支机构，为金融、制造、政务等核心领域的中大型企业提供持续、稳定的技术支撑与创新动力。
          </p>
          <div class="capability-stats">
            <div class="stat-item">
              <span class="stat-number">40+</span>
              <span class="stat-label">分支机构覆盖</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">3000+</span>
              <span class="stat-label">专业技术团队</span>
            </div>
          </div>
        </div>

        <div class="capability-right">
          <div class="capability-card">
            <div class="card-header">
              <div class="header-icon"></div>
              <h3>卓越的项目交付能力</h3>
            </div>
            <ul class="card-list">
              <li class="card-item">
                <div class="item-icon"></div>
                <div class="item-content">
                  <h4>极致标准化流程</h4>
                  <p>遵循 CMMI5 认证标准，端到端全链路数字化监控交付质量。</p>
                </div>
              </li>
              <li class="card-item">
                <div class="item-icon"></div>
                <div class="item-content">
                  <h4>全球离岸交付网络</h4>
                  <p>分布全球的交付中心，支持多时区无缝协同研发与运维。</p>
                </div>
              </li>
              <li class="card-item">
                <div class="item-icon"></div>
                <div class="item-content">
                  <h4>零缺陷安全管控</h4>
                  <p>内置安全开发生命周期（SDL），为金融级业务保驾护航。</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <button class="scroll-top-btn" aria-label="回到顶部">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
      </button>
    </section>

    <!-- 国内业务覆盖模块 -->
  

    <!-- 全链路技术服务体系模块 -->
    <section class="service-section">
      <div class="service-container">
        <div class="service-header">
          <div class="header-text">
            <h2 class="service-title">全链路技术服务体系</h2>
            <p class="service-desc">
              从战略到技术，从基础设施到上层应用，我们提供闭环的数字化支撑，降低企业转型门槛。
            </p>
          </div>
          <button class="download-btn">下载服务目录</button>
        </div>

        <div class="service-list">
          <div class="service-item">
            <span class="item-number">01</span>
            <h3 class="item-title">数字化咨询</h3>
            <p class="item-desc">
              顶层架构设计、业务流程重组规划、技术选型建议及数字化路线图制定。
            </p>
          </div>
          <div class="service-item">
            <span class="item-number">02</span>
            <h3 class="item-title">定制化软件研发</h3>
            <p class="item-desc">
              基于微服务的敏捷开发、APP/小程序开发、高性能后端系统及跨端交互设计。
            </p>
          </div>
          <div class="service-item">
            <span class="item-number">03</span>
            <h3 class="item-title">云与基础设施</h3>
            <p class="item-desc">
              混合云迁移、DevOps体系建立、云原生容器化改造及网络安全加固。
            </p>
          </div>
          <div class="service-item">
            <span class="item-number">04</span>
            <h3 class="item-title">AI与大数据分析</h3>
            <p class="item-desc">
              数据湖建设、生成式AI模型训练、智能客服及自动化业务流程工具（RPA）。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 企业介绍模块 -->
   

    <!-- 成功案例/客户展示模块 -->
   

    <!-- 合作伙伴 Logo 展示 -->
    <section class="partners-section">
      <div class="partners-container">
        <div class="partners-header">
          <h2 class="partners-title">合作伙伴</h2>
          <p class="partners-subtitle">携手行业领军企业，共创数智未来</p>
        </div>

        <div class="partners-grid">
          <!-- 第一行：银行 -->
          <div class="partner-item">
            <img src="/logos/Logo-wall/1-bank-of-china.png" alt="中国银行" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/2-china-citic-bank.png" alt="中信银行" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/3-industrial-bank.png" alt="兴业银行" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/4-china-minsheng-bank.png" alt="中国民生银行" />
          </div>

          <!-- 第二行：企业 -->
          <div class="partner-item">
            <img src="/logos/Logo-wall/5-cfetsit.png" alt="CFETSIT" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/6-sunwoda.png" alt="欣旺达" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/7-chint-group.png" alt="正泰集团" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/8-chengguang.png" alt="晨光" />
          </div>

          <!-- 第三行：科技品牌 -->
          <div class="partner-item">
            <img src="/logos/Logo-wall/9-minmax.png" alt="MINIMAX" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/10-xiaomi.png" alt="小米" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/11-red_book.png" alt="小红书" />
          </div>
          <div class="partner-item">
            <img src="/logos/Logo-wall/12-xun.png" alt="小寻" />
          </div>

          <!-- 第四行：能源/工程企业 -->
          <div class="partner-row-last">
            <div class="partner-item">
              <img src="/logos/Logo-wall/13-CNPC.png" alt="中国石油" />
            </div>
            <div class="partner-item">
              <img src="/logos/Logo-wall/14-yanchang.png" alt="延长石油" />
            </div>
            <div class="partner-item">
              <img src="/logos/Logo-wall/15-SNWDP.png" alt="南水北调" />
            </div>
            <div class="partner-item">
              <img src="/logos/Logo-wall/16-HUAKUN.png" alt="华鲲振宇" />
            </div>
            <div class="partner-item">
              <img src="/logos/Logo-wall/17-shanmei.png" alt="陕煤集团" />
            </div>
            <div class="partner-item">
              <img src="/logos/Logo-wall/18-WANBEI.png" alt="皖北煤电" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  @import '../styles/index.scss';
</style>

<script>
  // 回到顶部按钮功能
  const scrollTopBtn = document.querySelector('.scroll-top-btn');
  if (scrollTopBtn) {
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>
