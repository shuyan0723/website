import Swiper from 'swiper';
import { Navigation, Pagination, Autoplay } from 'swiper/modules';
import 'swiper/css';
import 'swiper/css/pagination';
import ContactCards from './ContactCards.astro';
import CareersContact from './CareersContact.astro';

// 主营业务与服务数据
const services = [
  {
    icon: "☁️",
    title: "云计算服务",
    desc: "提供弹性计算、存储、数据库等一站式云服务"
  },
  {
    icon: "🖥️",
    title: "系统集成",
    desc: "软硬件一体化集成解决方案，高效稳定"
  },
  {
    icon: "🔒",
    title: "网络安全",
    desc: "全方位安全防护，保障企业数据与业务安全"
  },
  {
    icon: "📊",
    title: "数据中心",
    desc: "高可用数据中心建设、运维与优化服务"
  },
  {
    icon: "⚙️",
    title: "IT运维服务",
    desc: "7×24小时专业运维，保障系统稳定运行"
  },
  {
    icon: "🤝",
    title: "数字化转型",
    desc: "企业数字化顶层设计与落地实施服务"
  }
];
