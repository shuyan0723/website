      <div class="narrative-timeline-wrapper">
        <!-- 叙事型曲线时间轴 -->
        <div class="narrative-timeline">
          <!-- SVG 波浪曲线 -->
          <svg class="curve-svg" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="curveGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#2455A5;stop-opacity:1" />
                <stop offset="50%" style="stop-color:#4A90E2;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#22D3EE;stop-opacity:1" />
              </linearGradient>
              <filter id="curveGlow">
                <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                <feMerge>
                  <feMergeNode in="coloredBlur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
            </defs>
            <!-- 波浪曲线：低-高-中-低-高，创造上下空白区域 -->
            <path class="curve-path"
                  d="M 100 200 C 200 200, 300 120, 400 120 C 500 120, 550 180, 650 180 C 750 180, 850 100, 1000 100 C 1100 100, 1150 180, 1100 180"
                  fill="none"
                  stroke="url(#curveGradient)"
                  stroke-width="4"
                  stroke-linecap="round"
                  filter="url(#curveGlow)"/>
            <!-- 曲线上的装饰点 -->
            <circle class="curve-dot" cx="100" cy="200" r="6"/>
            <circle class="curve-dot" cx="400" cy="120" r="6"/>
            <circle class="curve-dot" cx="650" cy="180" r="6"/>
            <circle class="curve-dot" cx="1000" cy="100" r="6"/>
          </svg>

          <!-- 固定位置的节点容器 - 错位布局 -->
          <div class="timeline-nodes-container">
            <!-- 节点1 - 左侧区域（曲线低谷下方） -->
            <div class="timeline-node timeline-node-left" data-slot="0">
              <div class="node-year">2020</div>
              <div class="node-text">昆仑时代（上海）系统集成有限公司正式成立，注册资金1亿元人民币，开启数字化服务新征程。</div>
            </div>

            <!-- 节点2 - 中上区域（曲线低谷下方） -->
            <div class="timeline-node timeline-node-mid-top" data-slot="1">
              <div class="node-year">2021</div>
              <div class="node-text">业务覆盖智能穿戴、汽车电子、金融科技等多个领域，员工规模突破1000人。</div>
            </div>

            <!-- 节点3 - 右侧区域（曲线低谷下方） -->
            <div class="timeline-node timeline-node-right" data-slot="2">
              <div class="node-year">2022</div>
              <div class="node-text">在北京、深圳、成都、杭州等地设立分公司，形成覆盖全国主要城市的服务网络。</div>
            </div>
          </div>
        </div>

        <!-- 内嵌式导航按钮 -->
        <button class="curve-nav-btn curve-prev-btn" id="curvePrev">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
