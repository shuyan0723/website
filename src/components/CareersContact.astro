---
---

<style>
    /* 动画定义 */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .fade-in { animation: fadeIn 0.4s ease-out; }
    
    /* 隐藏滚动条但保持功能 */
    .custom-scroll::-webkit-scrollbar { width: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #f1f1f1; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

    /* 卡片区域 - 隐藏（由 ContactCards 组件显示） */
    .contact-cards {
        display: none;
    }

    .card {
        background: white;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
        transform: translateY(0);
        border-top: 4px solid;
        position: relative;
        overflow: hidden;
    }
    .card:hover {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        transform: translateY(-8px);
    }
    .card-blue { border-color: #2563eb; }
    .card-orange { border-color: #f97316; }
    .card-purple { border-color: #9333ea; }

    .card-icon {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }
    .card-blue .card-icon { background: #dbeafe; color: #2563eb; }
    .card-blue:hover .card-icon { background: #2563eb; color: white; }
    .card-orange .card-icon { background: #ffedd5; color: #f97316; }
    .card-orange:hover .card-icon { background: #f97316; color: white; }
    .card-purple .card-icon { background: #f5f3ff; color: #9333ea; }
    .card-purple:hover .card-icon { background: #9333ea; color: white; }

    .card-icon i {
        font-size: 2rem;
    }

    .card h2 {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 0.75rem;
        color: #1f2937;
    }

    .card p {
        color: #6b7280;
        margin-bottom: 1.5rem;
    }

    .card-btn {
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    .card-blue .card-btn {
        background: #dbeafe;
        color: #2563eb;
    }
    .card-blue .card-btn:hover {
        background: #2563eb;
        color: white;
    }
    .card-orange .card-btn {
        background: #ffedd5;
        color: #f97316;
    }
    .card-orange .card-btn:hover {
        background: #f97316;
        color: white;
    }
    .card-purple .card-btn {
        background: #f5f3ff;
        color: #9333ea;
    }
    .card-purple .card-btn:hover {
        background: #9333ea;
        color: white;
    }

    .hot-badge {
        position: absolute;
        top: 0;
        right: 0;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 0.75rem;
        font-weight: bold;
        padding: 0.5rem 0.75rem;
        border-radius: 0 0 0 0.5rem;
    }

    /* 弹窗样式 */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 50;
        display: none;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
        padding: 1rem;
    }
    .modal-overlay.show {
        display: flex;
    }

    .modal-content {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 56rem;
        height: 85vh;
        display: flex;
        flex-direction: column;
        animation: fadeIn 0.4s ease-out;
    }

    .modal-header {
        background: #7c3aed;
        padding: 1.5rem;
        border-radius: 1rem 1rem 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modal-header p {
        color: #ddd6fe;
        font-size: 0.875rem;
        margin: 0.25rem 0 0 0;
    }

    .modal-close {
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        transition: color 0.2s ease;
    }
    .modal-close:hover {
        color: #e9d5ff;
    }

    .modal-search {
        padding: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
    }

    .search-box {
        position: relative;
    }
    .search-box i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }
    .search-box input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 1rem;
        outline: none;
        transition: all 0.2s ease;
    }
    .search-box input:focus {
        border-color: #9333ea;
        box-shadow: 0 0 0 3px rgba(147, 51, 234, 0.2);
    }

    .modal-body {
        flex-grow: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .job-item {
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        padding: 1.25rem;
        transition: all 0.2s ease;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
    }
    .job-item:hover {
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        border-color: #c4b5fd;
    }

    .job-item h4 {
        font-size: 1.125rem;
        font-weight: bold;
        color: #1f2937;
        margin: 0 0 0.5rem 0;
        transition: color 0.2s ease;
    }
    .job-item:hover h4 {
        color: #7c3aed;
    }

    .job-meta {
        display: flex;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: #6b7280;
    }

    .job-meta span {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .job-detail-btn {
        padding: 0.5rem 1.25rem;
        border: 1px solid #9333ea;
        color: #9333ea;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .job-detail-btn:hover {
        background: #9333ea;
        color: white;
    }

    /* 职位详情表单区域 */
    .resume-section {
        margin-top: 2rem;
        background: #f5f3ff;
        padding: 1.5rem;
        border-radius: 0.5rem;
        border: 1px solid #e9d5ff;
    }

    .resume-section h4 {
        font-size: 1.125rem;
        font-weight: bold;
        color: #6d28d9;
        margin: 0 0 0.5rem 0;
    }

    .resume-section p {
        color: #6b7280;
        margin: 0 0 1rem 0;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-group label {
        display: block;
        color: #374151;
        font-size: 0.875rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .form-group input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 1rem;
        outline: none;
        transition: all 0.2s ease;
    }

    .form-group input:focus {
        border-color: #9333ea;
        box-shadow: 0 0 0 3px rgba(147, 51, 234, 0.2);
    }

    .form-group small {
        color: #9ca3af;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    .submit-btn {
        width: 100%;
        padding: 0.75rem 1rem;
        background: #7c3aed;
        color: white;
        font-weight: bold;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    .submit-btn:hover {
        background: #6d28d9;
    }

    /* 成功弹窗 */
    .success-modal {
        max-width: 28rem;
        height: auto;
        padding: 2rem;
        text-align: center;
    }

    .success-icon {
        width: 4rem;
        height: 4rem;
        background: #dcfce7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem auto;
    }

    .success-icon i {
        font-size: 2rem;
        color: #22c55e;
    }

    .success-modal h3 {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
        margin: 0 0 0.5rem 0;
    }

    .success-modal p {
        color: #6b7280;
        margin: 0 0 1.5rem 0;
    }

    .success-btn {
        padding: 0.5rem 1.5rem;
        background: #22c55e;
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background 0.2s ease;
    }
    .success-btn:hover {
        background: #16a34a;
    }

    .job-detail-content h2 {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
        margin: 0 0 0.5rem 0;
    }

    .job-detail-meta {
        display: flex;
        gap: 2rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
    }

    .job-detail-meta span {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .job-section {
        margin-bottom: 1.5rem;
    }

    .job-section h4 {
        font-size: 1.125rem;
        font-weight: bold;
        color: #374151;
        margin: 0 0 0.75rem 0;
    }

    .job-section-content {
        background: #f9fafb;
        padding: 1rem;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        color: #4b5563;
    }
</style>

<!-- 核心三卡片区域 -->
<div class="contact-cards fade-in">
    
    <!-- 业务咨询 -->
    <div class="card card-blue">
        <div class="card-icon">
            <i class="fa-solid fa-headset"></i>
        </div>
        <h2>业务咨询</h2>
        <p>产品解决方案与技术支持。</p>
        <button class="card-btn" onclick="alert('这里跳转到咨询表单')">立即咨询</button>
    </div>

    <!-- 合作洽谈 -->
    <div class="card card-orange">
        <div class="card-icon">
            <i class="fa-solid fa-handshake"></i>
        </div>
        <h2>合作洽谈</h2>
        <p>携手生态伙伴，共创商业价值。</p>
        <button class="card-btn" onclick="alert('这里跳转到合作通道')">洽谈合作</button>
    </div>

    <!-- 诚聘英才 -->
    <div class="card card-purple">
        <span class="hot-badge">HOT</span>
        <div class="card-icon">
            <i class="fa-solid fa-user-tie"></i>
        </div>
        <h2>诚聘英才</h2>
        <p>寻找发光的你，加入精英团队。</p>
        <button class="card-btn" onclick="openCareersList()">
            查看职位 <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>
</div>

<!-- 弹窗层：职位列表页 -->
<div id="careers-list" class="modal-overlay">
    <div class="modal-content">
        <!-- 头部 -->
        <div class="modal-header">
            <div>
                <h3><i class="fa-solid fa-briefcase"></i>热招职位</h3>
                <p>Join us and build the future together</p>
            </div>
            <button class="modal-close" onclick="closeAllModals()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        
        <!-- 搜索栏 -->
        <div class="modal-search">
            <div class="search-box">
                <i class="fa-solid fa-search"></i>
                <input type="text" placeholder="搜索职位名称...">
            </div>
        </div>

        <!-- 职位列表内容 (可滚动) -->
        <div class="modal-body custom-scroll">
            
            <!-- 职位项 1 -->
            <div class="job-item">
                <div>
                    <h4>高级系统集成工程师</h4>
                    <div class="job-meta">
                        <span><i class="fa-solid fa-location-dot"></i>上海</span>
                        <span><i class="fa-solid fa-clock"></i>3-5年经验</span>
                        <span><i class="fa-solid fa-calendar"></i>发布于 2天前</span>
                    </div>
                </div>
                <button class="job-detail-btn" onclick="openJobDetail('高级系统集成工程师', '上海', '3-5年经验', '负责大型系统集成项目的方案设计、实施与管理。', '1. 本科及以上学历，计算机相关专业；2. 5年以上系统集成经验；3. 熟悉主流服务器、存储、网络设备；4. 具备PMP认证者优先。')">
                    查看详情
                </button>
            </div>

            <!-- 职位项 2 -->
            <div class="job-item">
                <div>
                    <h4>大客户销售经理</h4>
                    <div class="job-meta">
                        <span><i class="fa-solid fa-location-dot"></i>北京</span>
                        <span><i class="fa-solid fa-clock"></i>5年以上经验</span>
                        <span><i class="fa-solid fa-calendar"></i>发布于 1周前</span>
                    </div>
                </div>
                <button class="job-detail-btn" onclick="openJobDetail('大客户销售经理', '北京', '5年以上经验', '负责关键客户的开发、维护与关系管理，达成销售目标。', '1. 本科及以上学历；2. 8年以上IT行业销售经验；3. 具备丰富的政府或金融行业客户资源；4. 出色的谈判与沟通能力。')">
                    查看详情
                </button>
            </div>

            <!-- 职位项 3 -->
            <div class="job-item">
                <div>
                    <h4>UI/UX 设计师</h4>
                    <div class="job-meta">
                        <span><i class="fa-solid fa-location-dot"></i>杭州</span>
                        <span><i class="fa-solid fa-clock"></i>1-3年经验</span>
                        <span><i class="fa-solid fa-calendar"></i>发布于 2周前</span>
                    </div>
                </div>
                <button class="job-detail-btn" onclick="openJobDetail('UI/UX 设计师', '杭州', '1-3年经验', '负责公司产品的用户体验设计与界面视觉设计。', '1. 专科及以上学历，艺术设计类专业；2. 熟练使用Figma/Sketch/Axure等设计工具；3. 有1年以上B端产品设计经验；4. 对交互设计有浓厚兴趣。')">
                    查看详情
                </button>
            </div>

            <!-- 职位项 4 -->
            <div class="job-item">
                <div>
                    <h4>Java后端开发专家</h4>
                    <div class="job-meta">
                        <span><i class="fa-solid fa-location-dot"></i>深圳</span>
                        <span><i class="fa-solid fa-clock"></i>5-10年经验</span>
                        <span><i class="fa-solid fa-calendar"></i>发布于 3天前</span>
                    </div>
                </div>
                <button class="job-detail-btn" onclick="openJobDetail('Java后端开发专家', '深圳', '5-10年经验', '负责核心业务系统的架构设计与后端开发工作。', '1. 本科及以上学历，计算机相关专业；2. 精通Java及主流开发框架(Spring Boot, MyBatis等)；3. 熟悉微服务架构、数据库设计；4. 有高并发系统开发经验者优先。')">
                    查看详情
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 弹窗层：职位详情页 -->
<div id="job-detail" class="modal-overlay">
    <div class="modal-content">
        <!-- 头部 -->
        <div class="modal-header">
            <h3><i class="fa-solid fa-file-contract"></i>职位详情</h3>
            <button class="modal-close" onclick="closeAllModals()"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- 详情内容 (可滚动) -->
        <div class="modal-body custom-scroll">
            <div id="job-detail-content">
                <!-- 内容由JS动态填充 -->
            </div>
            
            <!-- 简历投递区域 -->
            <div class="resume-section">
                <h4>投递简历</h4>
                <p>请上传您的简历（支持 Word, PDF, JPG, PNG 格式）</p>
                
                <div class="form-group">
                    <label>您的姓名</label>
                    <input type="text" id="applicant-name" placeholder="请输入您的姓名">
                </div>
                <div class="form-group">
                    <label>联系电话</label>
                    <input type="tel" id="applicant-phone" placeholder="请输入您的手机号">
                </div>
                <div class="form-group">
                    <label>上传简历</label>
                    <input type="file" id="resume-upload" accept=".doc,.docx,.pdf,.jpg,.jpeg,.png">
                    <small>支持格式：Word, PDF, JPG, PNG (最大 10MB)</small>
                </div>
                <button class="submit-btn" onclick="submitResume()">
                    <i class="fa-solid fa-paper-plane"></i>提交简历
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 弹窗层：投递成功提示 -->
<div id="success-modal" class="modal-overlay">
    <div class="modal-content success-modal">
        <div class="success-icon">
            <i class="fa-solid fa-check"></i>
        </div>
        <h3>投递成功！</h3>
        <p>您的简历已成功提交，我们将尽快与您联系。</p>
        <button class="success-btn" onclick="closeAllModals()">确定</button>
    </div>
</div>

<script is:inline>
    // 打开职位列表
    function openCareersList() {
        document.getElementById('careers-list').classList.add('show');
    }

    // 打开职位详情
    function openJobDetail(title, location, experience, responsibilities, requirements) {
        document.getElementById('job-detail-content').innerHTML = `
            <div>
                <h2>${title}</h2>
                <div class="job-detail-meta">
                    <span><i class="fa-solid fa-location-dot"></i> ${location}</span>
                    <span><i class="fa-solid fa-clock"></i> ${experience}</span>
                </div>
                
                <div class="job-section">
                    <h4>岗位职责</h4>
                    <div class="job-section-content">${responsibilities}</div>
                </div>
                <div class="job-section">
                    <h4>任职要求</h4>
                    <div class="job-section-content">${requirements}</div>
                </div>
            </div>
        `;
        document.getElementById('careers-list').classList.remove('show');
        document.getElementById('job-detail').classList.add('show');
    }

    // 提交简历
    function submitResume() {
        const name = document.getElementById('applicant-name').value;
        const phone = document.getElementById('applicant-phone').value;
        const fileInput = document.getElementById('resume-upload');
        const file = fileInput.files[0];

        if (!name || !phone) {
            alert('请填写您的姓名和联系电话！');
            return;
        }
        if (!file) {
            alert('请选择要上传的简历文件！');
            return;
        }

        console.log('提交信息:', { name, phone, file });

        document.getElementById('job-detail').classList.remove('show');
        document.getElementById('success-modal').classList.add('show');
    }

    // 关闭所有弹窗
    function closeAllModals() {
        document.getElementById('careers-list').classList.remove('show');
        document.getElementById('job-detail').classList.remove('show');
        document.getElementById('success-modal').classList.remove('show');
    }

    // 点击遮罩层关闭弹窗
    document.addEventListener('click', function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            closeAllModals();
        }
    });
</script>