<style>
  .footer {
    width: 100%;
    background: #ffffff;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 42px 24px 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr repeat(6, 1fr);
    gap: 36px;
    align-items: start;
    padding-bottom: 40px;
  }

  .brand-wrap {
    max-width: 215px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .logo-mark {
    width: 20px;
    height: 28px;
    border-radius: 5px;
    background: linear-gradient(165deg, #5793ff 0%, #1f5fff 100%);
    position: relative;
    box-shadow: 0 0 0 1px rgba(130, 162, 235, 0.2) inset;
  }

  .logo-mark::before,
  .logo-mark::after {
    content: "";
    position: absolute;
    left: 6px;
    width: 8px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.78);
  }

  .logo-mark::before {
    top: 6px;
    height: 4px;
  }

  .logo-mark::after {
    top: 14px;
    height: 8px;
  }

  .logo-text {
    color: #1f2937;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 1px;
    font-size: 34px;
    transform: scale(0.34);
    transform-origin: left center;
    width: 100px;
    margin-right: -40px;
  }

  .intro {
    font-size: 14px;
    line-height: 1.85;
    color: #6b7280;
    margin-bottom: 22px;
  }

  .social {
    display: flex;
    gap: 12px;
  }

  .social span {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #6b7280;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .social span:hover {
    background: #e5e7eb;
    border-color: #d1d5db;
  }

  .col h3 {
    color: #1f2937;
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 12px 0;
    letter-spacing: 0.2px;
  }

  .col ul {
    list-style: none;
  }

  .col li {
    color: #6b7280;
    font-size: 14px;
    margin-top: 10px;
    letter-spacing: 0.2px;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .col li a {
    color: inherit;
    text-decoration: none;
  }

  .col li:hover,
  .col li a:hover {
    color: #2455A5;
  }

  .contact li {
    white-space: normal;
    line-height: 1.5;
    display: flex;
    gap: 7px;
    align-items: flex-start;
  }

  .contact .icon {
    color: #2455A5;
    line-height: 1.4;
  }

  .copyright {
    border-top: 1px solid #e5e7eb;
    text-align: center;
    color: #6b7280;
    font-size: 14px;
    padding: 28px 0 30px;
    letter-spacing: 0.1px;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(170px, 1fr));
    }

    .brand-wrap {
      grid-column: span 3;
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding: 32px 20px 0;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(140px, 1fr));
      gap: 24px;
    }

    .brand-wrap {
      grid-column: span 2;
    }
  }
</style>
