---
// 联系我们三卡片组件
---

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="contact-cards-container">
    <!-- 卡片 1: 业务咨询 -->
    <div class="contact-card business-card">
        <div class="card-icon-wrapper">
            <i class="fa-solid fa-headset"></i>
        </div>
        <h2 class="card-title">业务咨询</h2>
        <p class="card-desc">获取最新的产品解决方案与技术支持服务。</p>
        <ul class="card-info">
            <li><i class="fa-solid fa-phone"></i> 021-58356927</li>
            <li><i class="fa-solid fa-envelope"></i> shiyuting@kunlunera.com</li>
        </ul>
        <button class="card-btn" onclick="router('page-business')">
            立即咨询 <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>

    <!-- 卡片 2: 合作洽谈 -->
    <div class="contact-card partner-card">
        <div class="card-icon-wrapper">
            <i class="fa-solid fa-handshake"></i>
        </div>
        <h2 class="card-title">合作洽谈</h2>
        <p class="card-desc">携手生态伙伴，共创商业价值，实现互利共赢。</p>
        <ul class="card-info">
            <li><i class="fa-solid fa-briefcase"></i> 渠道 / 供应商 / 媒体</li>
            <li><i class="fa-solid fa-envelope"></i> shiyuting@kunlunera.com</li>
        </ul>
        <button class="card-btn" onclick="router('page-partner')">
            洽谈合作 <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>

    <!-- 卡片 3: 诚聘英才 -->
    <div class="contact-card careers-card">
        <div class="card-icon-wrapper">
            <i class="fa-solid fa-user-tie"></i>
        </div>
        <h2 class="card-title">诚聘英才</h2>
        <p class="card-desc">寻找发光的你，加入我们的精英团队，共筑未来。</p>
        <ul class="card-info">
            <li><i class="fa-solid fa-building"></i> 扁平化管理 / 弹性工作</li>
            <li><i class="fa-solid fa-envelope"></i> hr@kunlun-era.com</li>
        </ul>
        <button class="card-btn" onclick="openCareersList()">
            查看职位 <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>
</div>

<!-- 模态框：业务咨询表单 -->
<div id="page-business" class="modal-overlay">
    <div class="modal-content business-modal">
        <div class="modal-header">
            <h3><i class="fa-solid fa-headset"></i>业务咨询提交</h3>
            <button class="modal-close" onclick="closeAllPages()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <form onsubmit="handleBusinessSubmit(event)">
                <div class="form-group">
                    <label>您的姓名</label>
                    <input type="text" placeholder="请输入姓名">
                </div>
                <div class="form-group">
                    <label>联系电话</label>
                    <input type="tel" placeholder="请输入手机号">
                </div>
                <div class="form-group">
                    <label>咨询内容</label>
                    <textarea rows="4" placeholder="请简述您的需求..."></textarea>
                </div>
                <button type="submit" class="submit-btn">发送留言</button>
            </form>
        </div>
    </div>
</div>

<!-- 模态框：合作洽谈列表 -->
<div id="page-partner" class="modal-overlay">
    <div class="modal-content partner-modal">
        <div class="modal-header">
            <h3><i class="fa-solid fa-handshake"></i>商务合作通道</h3>
            <button class="modal-close" onclick="closeAllPages()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="partner-list">
                <div class="partner-item">
                    <div class="partner-icon">
                        <i class="fa-solid fa-store"></i>
                    </div>
                    <div>
                        <h4>渠道代理合作</h4>
                        <p>申请成为我们的区域代理商或行业合作伙伴。</p>
                        <span>partner@kunlun-era.com</span>
                    </div>
                </div>
                <div class="partner-item">
                    <div class="partner-icon">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <div>
                        <h4>供应商入驻</h4>
                        <p>硬件、软件及服务类供应商资质提交。</p>
                        <span>supply@kunlun-era.com</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<style>
    /* 容器 */
    .contact-cards-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 5rem;
        animation: fadeIn 0.5s ease-in-out;
    }

    @media (min-width: 768px) {
        .contact-cards-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* 淡入动画 */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 卡片通用样式 */
    .contact-card {
        background: white;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
        border-top: 4px solid;
    }

    .contact-card:hover {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        transform: translateY(-8px);
    }

    /* 业务咨询卡片 */
    .business-card {
        border-top-color: #2563eb;
    }

    .business-card .card-icon-wrapper {
        background: #dbeafe;
        color: #2563eb;
    }

    .business-card .card-icon-wrapper:hover {
        background: #2563eb;
        color: white;
    }

    .business-card .card-btn {
        background: #dbeafe;
        color: #2563eb;
    }

    .business-card .card-btn:hover {
        background: #2563eb;
        color: white;
    }

    .business-card .card-info i {
        color: #3b82f6;
    }

    /* 合作洽谈卡片 */
    .partner-card {
        border-top-color: #f97316;
    }

    .partner-card .card-icon-wrapper {
        background: #ffedd5;
        color: #f97316;
    }

    .partner-card .card-icon-wrapper:hover {
        background: #f97316;
        color: white;
    }

    .partner-card .card-btn {
        background: #ffedd5;
        color: #f97316;
    }

    .partner-card .card-btn:hover {
        background: #f97316;
        color: white;
    }

    .partner-card .card-info i {
        color: #fb923c;
    }

    /* 诚聘英才卡片 */
    .careers-card {
        border-top-color: #9333ea;
    }

    .careers-card .card-icon-wrapper {
        background: #f5f3ff;
        color: #9333ea;
    }

    .careers-card .card-icon-wrapper:hover {
        background: #9333ea;
        color: white;
    }

    .careers-card .card-btn {
        background: #f5f3ff;
        color: #9333ea;
    }

    .careers-card .card-btn:hover {
        background: #9333ea;
        color: white;
    }

    .careers-card .card-info i {
        color: #a855f7;
    }

    /* 卡片内部元素 */
    .card-icon-wrapper {
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        font-size: 2rem;
        transition: all 0.3s ease;
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
        margin-bottom: 0.75rem;
    }

    .card-desc {
        color: #6b7280;
        margin-bottom: 1.5rem;
        height: 2.5rem;
    }

    .card-info {
        list-style: none;
        padding: 0;
        margin: 0 0 2rem 0;
        font-size: 0.875rem;
        color: #4b5563;
    }

    .card-info li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .card-info li:last-child {
        margin-bottom: 0;
    }

    .card-btn {
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 1.125rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    /* 模态框遮罩 */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 50;
        display: none;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .modal-overlay.active {
        display: flex;
    }

    /* 模态框内容 */
    .modal-content {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 48rem;
        margin: 1rem;
        overflow: hidden;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    /* 模态框头部 */
    .modal-header {
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
        font-size: 1.25rem;
        font-weight: bold;
    }

    .business-modal .modal-header {
        background: #2563eb;
    }

    .partner-modal .modal-header {
        background: #f97316;
    }



    .modal-close {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        font-size: 1.25rem;
        padding: 0.5rem;
        transition: color 0.2s;
    }

    .modal-close:hover {
        color: rgba(255, 255, 255, 0.8);
    }

    /* 模态框主体 */
    .modal-body {
        padding: 2rem;
        overflow-y: auto;
        flex: 1;
    }

    /* 表单样式 */
    .form-group {
        margin-bottom: 1rem;
    }

    .form-group label {
        display: block;
        color: #374151;
        font-size: 0.875rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 0.5rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 1rem;
        transition: outline 0.2s, box-shadow 0.2s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5);
    }

    .submit-btn {
        width: 100%;
        padding: 0.75rem 1rem;
        background: #2563eb;
        color: white;
        font-weight: bold;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .submit-btn:hover {
        background: #1d4ed8;
    }

    /* 合作列表 */
    .partner-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .partner-item {
        display: flex;
        align-items: flex-start;
        padding: 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .partner-item:hover {
        background: #ffedd5;
    }

    .partner-icon {
        background: #ffedd5;
        color: #f97316;
        padding: 0.75rem;
        border-radius: 0.75rem;
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .partner-item h4 {
        font-weight: bold;
        font-size: 1.125rem;
        color: #1f2937;
        margin: 0 0 0.25rem 0;
    }

    .partner-item p {
        color: #6b7280;
        font-size: 0.875rem;
        margin: 0 0 0.5rem 0;
    }

    .partner-item span {
        display: inline-block;
        font-size: 0.75rem;
        background: #ffedd5;
        color: #c2410c;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
    }

</style>

<script is:inline>
    function router(pageId) {
        closeAllPages();
        const page = document.getElementById(pageId);
        if (page) {
            page.style.display = 'flex';
        }
    }

    function closeAllPages() {
        const pages = ['page-business', 'page-partner'];
        pages.forEach(id => {
            const page = document.getElementById(id);
            if (page) {
                page.style.display = 'none';
            }
        });
    }

    function handleBusinessSubmit(event) {
        event.preventDefault();
        alert('提交成功！我们会尽快联系您。');
        closeAllPages();
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            closeAllPages();
        }
    }
</script>